generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// NextAuth standard models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  goals         Goal[]
  decisions     Decision[]
  conversations Conversation[]
  savedPlans    SavedPlan[]
  notificationPrefs NotificationPreference?
  notifications Notification[]
  reminders     Reminder[]
}

enum Role {
  USER
  SUPPORT
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  status      String      @default("In Progress") // In Progress, Completed, Not Started
  progress    Int         @default(0)
  dueDate     DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Milestone {
  id        String   @id @default(cuid())
  goalId    String
  title     String
  done      Boolean  @default(false)
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decision {
  id           String            @id @default(cuid())
  userId       String
  title        String
  budget       String?
  deadline     DateTime?
  status       String            @default("Pending") // Pending, Decided
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  options      DecisionOption[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model DecisionOption {
  id          String           @id @default(cuid())
  decisionId  String
  title       String
  description String?
  decision    Decision         @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  results     ScenarioResult[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ScenarioResult {
  id          String         @id @default(cuid())
  optionId    String
  likelihood  String?        // High, Medium, Low
  tradeOffs   String?        @db.Text
  analysis    String?        @db.Text
  isMock      Boolean        @default(true)
  option      DecisionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // user or ai
  content        String       @db.Text
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model SavedPlan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String   // Decision, Plan
  status    String   // Decided, Active, Pending, Draft
  summary   String?  @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------
// Admin and Analytics Models
// ----------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String   // e.g., "UPDATE_ROLE", "DELETE_USER"
  targetId    String?  // Id of the affected record
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  userId      String?
  metadata    String?  @db.Text // JSON string for flexibility
  createdAt   DateTime @default(now())
}

// ----------------------------------------------------------------------
// Notifications, Reminders, and Preferences
// ----------------------------------------------------------------------

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(false)
  pushEnabled     Boolean  @default(false)
  quietHoursStart String?  // e.g., "22:00"
  quietHoursEnd   String?  // e.g., "08:00"
  timezone        String   @default("UTC")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  category  String   @default("SYSTEM") // SYSTEM, REMINDER, GOAL
  link      String?  
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Reminder {
  id           String   @id @default(cuid())
  userId       String
  title        String
  targetType   String?  // e.g., "GOAL", "MILESTONE"
  targetId     String?  // The ID of the specific goal/milestone
  scheduledFor DateTime
  status       String   @default("PENDING") // PENDING, SENT, CANCELLED
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
